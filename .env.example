# Account-wide Plex token. app.plex.tv -> any item -> Get Info -> View XML,
# then copy X-Plex-Token from the URL.
PLEX_TOKEN=

# Whose plays may be stored, as Plex account ids, comma separated. The server
# is shared, so a play by anyone not named here is dropped at ingest rather
# than written: filtering on read would leave the row on disk, which is the
# part that needed consent. 1 is the server owner on every Plex install, and
# is the default if this is left unset.
PLEX_ACCOUNT_IDS=1

# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Compose reads these; DATABASE_URL must agree with them or the API silently
# points at the wrong credentials.
POSTGRES_USER=engram
POSTGRES_PASSWORD=engram
POSTGRES_DB=engram
POSTGRES_PORT=55432

DATABASE_URL=postgres://engram:engram@localhost:55432/engram

# The API's port. Deliberately not 3000: it is registered as the GitHub OAuth
# app's callback host, so a collision with another project would mean editing
# that registration rather than a flag. The SPA sits next to it on 2011.
PORT=2012

# Shared secret required on every inbound webhook. Engram runs on a different
# host from the media stack, so this endpoint is publicly reachable and this is
# the only thing stopping a stranger writing into the watch history.
#   openssl rand -hex 32
WEBHOOK_SECRET=

# GitHub OAuth, owner-only. Register a separate app for production: one app's
# client secret is shared across every redirect URI on it, so reusing the
# development registration would make a leak from a laptop a production
# credential. Callback URL is <api-origin>/auth/github/callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# The owner's numeric GitHub id, never the login: a login can be renamed and the
# freed name claimed by someone else.
#   curl -s https://api.github.com/users/<login> | jq .id
OWNER_GITHUB_USER_ID=

# Signs the OAuth state and nothing else.
#   openssl rand -hex 32
OAUTH_STATE_SECRET=

# The SPA's origin. A bare origin: `next` is appended to it, so a trailing slash
# would build `//path`, which a browser reads as a host.
WEB_ORIGIN=http://localhost:2011

# Unset in development, where the API and the SPA are both on localhost.
# SESSION_COOKIE_DOMAIN=

VITE_API_ORIGIN=http://localhost:2012
