    "public.watch_state": {
      "columns": {
        "title_id": {
          "name": "title_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "episode_id": {
          "name": "episode_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": false
        },
        "first_watched_at": {
          "name": "first_watched_at",
          "type": "timestamp with time zone",
          "primaryKey": false,
          "notNull": false
        },
        "last_watched_at": {
          "name": "last_watched_at",
          "type": "timestamp with time zone",
          "primaryKey": false,
          "notNull": false
        },
        "watched_precision": {
          "name": "watched_precision",
          "type": "watch_precision",
          "typeSchema": "public",
          "primaryKey": false,
          "notNull": true
        },
        "play_count": {
          "name": "play_count",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "seen": {
          "name": "seen",
          "type": "boolean",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n  select\n    title_id,\n    episode_id,\n    min(watched_at) as first_watched_at,\n    max(watched_at) as last_watched_at,\n    min(watched_precision) as watched_precision,\n    count(*)::int as play_count,\n    bool_or(completed) as seen\n  from watch_event\n  group by title_id, episode_id\n",
      "name": "watch_state",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
