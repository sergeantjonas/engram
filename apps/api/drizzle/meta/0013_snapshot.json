  "views": {
    "public.watch_state": {
      "columns": {
        "title_id": {
          "name": "title_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "episode_id": {
          "name": "episode_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": false
        },
        "first_watched_at": {
          "name": "first_watched_at",
          "type": "timestamp with time zone",
          "primaryKey": false,
          "notNull": false
        },
        "last_watched_at": {
          "name": "last_watched_at",
          "type": "timestamp with time zone",
          "primaryKey": false,
          "notNull": false
        },
        "first_watched_precision": {
          "name": "first_watched_precision",
          "type": "watch_precision",
          "typeSchema": "public",
          "primaryKey": false,
          "notNull": true
        },
        "last_watched_precision": {
          "name": "last_watched_precision",
          "type": "watch_precision",
          "typeSchema": "public",
          "primaryKey": false,
          "notNull": true
        },
        "play_count": {
          "name": "play_count",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "seen": {
          "name": "seen",
          "type": "boolean",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n  select\n    title_id,\n    episode_id,\n    -- Finished plays only, for the same reason play_count counts them: a\n    -- play-grained source reports stopping, and a title sampled for two\n    -- minutes would otherwise read as watched today everywhere a date is\n    -- shown, while the episode under it still read unseen.\n    min(watched_at) filter (where completed) as first_watched_at,\n    max(watched_at) filter (where completed) as last_watched_at,\n    -- A null boundary collapses to unknown precision, the same pairing\n    -- watch_event_precision_date holds the events themselves to.\n    coalesce(\n      (array_agg(watched_precision order by watched_at asc nulls last)\n        filter (where completed))[1],\n      'unknown'::watch_precision\n    ) as first_watched_precision,\n    coalesce(\n      (array_agg(watched_precision order by watched_at desc nulls last)\n        filter (where completed))[1],\n      'unknown'::watch_precision\n    ) as last_watched_precision,\n    -- Viewings rather than claims. Sources differ in grain: Plex history and\n    -- Tautulli write one row per play, so those are counted; the library walk\n    -- writes one row per episode carrying its own total, so that is taken\n    -- whole; a mark by hand asserts only that something was seen. The larger\n    -- of the two wins because they describe the same viewing from different\n    -- angles.\n    --\n    -- Completed rows only, because a play-grained source reports stopping and\n    -- not finishing: Tautulli sends one row every time playback stops, so an\n    -- episode watched over three sittings arrives as three rows of which one\n    -- is a viewing. Plex history writes nothing it does not already consider\n    -- watched, so this excludes none of it.\n    --\n    -- The floor lifts to one only once something finished, which is what makes\n    -- an episode known solely from a mark by hand read as watched once rather\n    -- than never. A literal one would instead report a play for an episode\n    -- that was started and abandoned, and the title header sums this column\n    -- without asking whether the episode was seen.\n    greatest(\n      count(*) filter (where completed and source in ('plex-history', 'tautulli')),\n      coalesce(max(plays), 0),\n      case when bool_or(completed) then 1 else 0 end\n    )::int as play_count,\n    bool_or(completed) as seen\n  from watch_event\n  group by title_id, episode_id\n",
      "name": "watch_state",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
