{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "noEmit": true,
    "incremental": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true
  },
  "include": ["src"],
  // Built before this project is checked. `@engram/shared` resolves through
  // node_modules to its `dist`, and without the reference `tsc -b` is free to
  // check this one first and find no types there.
  "references": [{ "path": "../../packages/shared" }]
}
