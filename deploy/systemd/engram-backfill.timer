[Unit]
Description=Backfill Engram from TMDB after the nightly library walk

[Timer]
# After the walk the Bytesized slot posts, which is what adds titles in bulk.
# Nothing orders the two across machines: a walk that runs late is picked up
# the next night, since both backfills go over every title on every run.
# Clear of both tenants' dumps as well.
OnCalendar=*-*-* 05:30:00
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
