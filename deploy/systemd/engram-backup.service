[Unit]
Description=Dump the Engram database and send a sealed copy off the box
# The dump runs through `docker compose exec`, so the daemon has to be up
# before this is worth attempting.
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy

# The script finds compose.prod.yaml relative to itself, and the deploy lands
# it flat in this directory rather than under ops/. Both facts are load
# bearing: a timer runs with no meaningful working directory of its own.
WorkingDirectory=/srv/engram
ExecStart=/srv/engram/backup.sh
# The copy that leaves the box. A oneshot runs its ExecStart lines in order
# and stops at the first that fails, so this sends the dump the line above
# just wrote, or nothing.
ExecStart=/srv/engram/offsite.sh

# The upload key and the age recipient, root-only and outside the tree a
# deploy writes to. That does not keep the key from deploy, which drives the
# Docker daemon; what the key can do is what bounds it. Optional so that a
# missing file costs the off-box copy and not the local dump: offsite.sh
# fails on the unset values, and the unit with it.
EnvironmentFile=-/etc/engram/offsite.env

Environment=BACKUP_DIR=/var/backups/engram
# Thirty dumps of a few hundred KB each. The history is the product, and the
# cost of keeping a month of it is nothing next to the cost of not.
Environment=KEEP_DAYS=30

# Outside /srv on purpose: the deploy rsyncs into /srv/engram, and a backup
# living inside the directory a deploy writes to is one flag away from being
# deleted by the thing it exists to survive.
ReadWritePaths=/var/backups/engram

[Install]
WantedBy=multi-user.target
