[Unit]
Description=Walk the Plex library nightly and post it to Engram

[Timer]
# In Engram's timezone rather than the slot's, so it stays an hour ahead of
# engram-backfill.timer on the VPS whatever either host is set to.
OnCalendar=*-*-* 04:30:00 Europe/Brussels
RandomizedDelaySec=15m
# A slot that was down at 04:30 still gets its walk when it comes back.
Persistent=true

[Install]
WantedBy=timers.target
